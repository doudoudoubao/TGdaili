# systemd 开机自启单元：放到 /etc/systemd/system/tgforward.service
#   sudo cp tgforward.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tgforward
#   journalctl -u tgforward -f        # 看日志
[Unit]
Description=TG Bot 一键转发
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 改成你实际的目录和用户
WorkingDirectory=/opt/tgdaili
ExecStart=/usr/bin/python3 /opt/tgdaili/forward_bot.py --config /opt/tgdaili/config.json
User=nobody
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# 如果需要代理才能连上 Telegram，取消下面这行的注释并改成自己的
# Environment=HTTPS_PROXY=http://127.0.0.1:7890

[Install]
WantedBy=multi-user.target
